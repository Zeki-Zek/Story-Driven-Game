--- !u!114 &910524107
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 910524106}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d9b4d2804c86b24b93d5d0e76ffe92f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Eliza
        icon: {fileID: -7397507068737644762, guid: acd99ba47e04b054e80c30e7cdf94f6b, type: 3}
      line: 'Oh Elian, how long has it been. I''m glad you''re well... '
    - character:
        name: Elian
        icon: {fileID: -5117027057947568564, guid: b225ad4cbe9a5b1488f4f42dc2887f20, type: 3}
      line: Hello, Ms.Eliza, it's been a while indeed... I'm sorry...
    - character:
        name: Eliza
        icon: {fileID: -7397507068737644762, guid: acd99ba47e04b054e80c30e7cdf94f6b, type: 3}
      line: 'Your frame is lighter, your smile is torn... '
    - character:
        name: Elian
        icon: {fileID: -7254910017412986436, guid: 07cc015d12e3f7e44ba677cb007ff546, type: 3}
      line: 'Yes... '
    - character:
        name: Eliza
        icon: {fileID: -7397507068737644762, guid: acd99ba47e04b054e80c30e7cdf94f6b, type: 3}
      line: You must be tired, you should head to the apartment I got for you, just
        head down the street.
    - character:
        name: Elian
        icon: {fileID: -5117027057947568564, guid: b225ad4cbe9a5b1488f4f42dc2887f20, type: 3}
      line: Thank you very much, I'll contact you as soon as I got there.
    - character:
        name: Quest
        icon: {fileID: -7862751560490577435, guid: 28edcd99297f7d840a27fe20a6247be6, type: 3}
      line: "\"Find Your House\" \nHint: it has a stairs and it's near a huge market"
