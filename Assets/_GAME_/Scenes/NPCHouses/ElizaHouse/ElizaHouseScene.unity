--- !u!114 &2003786633
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2003786631}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d9b4d2804c86b24b93d5d0e76ffe92f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Elian
        icon: {fileID: -5117027057947568564, guid: b225ad4cbe9a5b1488f4f42dc2887f20, type: 3}
      line: Perhaps, do you know someone named Eliza? Ms.Eliza?
    - character:
        name: Kaia
        icon: {fileID: 5661314660147894343, guid: 6bfc542adbc91bf499668d17528d0624, type: 3}
      line: Ms.Eliza? Oh yes, I know about her. She's my neighbor to be exact.
    - character:
        name: Kaia
        icon: {fileID: 5661314660147894343, guid: 6bfc542adbc91bf499668d17528d0624, type: 3}
      line: Just go to your right and you'll find a huge violet house. That's hers
    - character:
        name: Elian
        icon: {fileID: -5117027057947568564, guid: b225ad4cbe9a5b1488f4f42dc2887f20, type: 3}
      line: I see, thank you very much!
    - character:
        name: Kaia
        icon: {fileID: 5661314660147894343, guid: 6bfc542adbc91bf499668d17528d0624, type: 3}
      line: '*Kaia is looking at you with interest*'
